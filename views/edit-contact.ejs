<div class="container-fluid mt-5">
    <div class="row pt-4">
        <div class="col-md-6">
            <h2>Change Ingredient Source</h2>
            <% if (typeof errors != 'undefined') { %>
                <div class="alert alert-danger" role="alert">
                    <ul>
                        <% errors.forEach(error => { %>
                            <li><%= error.msg %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>
            <form method="post" action="/contact?_method=PUT">
            <input type="hidden" name="_id" value="<%= contact._id %>">
            <input type="hidden" name="oldNama" value="<%= contact.oldNama || contact.nama %>"/>
            <div class="mb-3">
            <label for="nama" class="form-label">Name</label>
            <input type="text" class="form-control" id="nama" name="nama" required value="<%= contact.nama %>">
            </div>
            <div class="mb-3">
            <label for="nomor" class="form-label">Phone Number</label>
            <input type="text" class="form-control" id="nomor" name="nomor" value="<%= contact.nomor %>">
            </div>
            <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" name="email" value="<%= contact.email %>">
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary" style="background-color: #3d2b1f; color: #ffffff;">Change Data</button>
            </div>
            </form>
            </div>
        </div>
    </div>
</div>