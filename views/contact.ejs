<div class="container-fluid">
  <div class="row">
    <div class="col-lg-7 ps-0">
      <h2 class="judulMyfav pt-0">Ingredient Guide</h2>
      <a href="/contact/add" class="btn btn-primary mb-2 ms-1" style="background-color: #3d2b1f; color: #ffffff;">Add Source</a>
      <% if (pesan.length !== 0) { %>
       <div class="alert alert-success fw-bold" role="alert">
            <%= pesan %>
          </div>
      <% } %>
      <table class="table">
  <thead>
    <tr>
      <th scope="col">No</th>
      <th scope="col">Name</th>
      <th scope="col">Phone Number</th>
      <th scope="col">Action</th>
    </tr>
  </thead>
  <tbody>
    <% if (contacts.length === 0) { %>
      <tr>
        <td colspan="4">
          <div class="alert alert-danger fw-bold" role="alert">
            No Ingredient Source !!!
          </div>
        </td>
      </tr>
    <% } %>
    <% contacts.forEach((contact,i) => {%>
     <tr>
      <th scope="row"><%=i+1%></th>
      <td><%= contact.nama %></td>
      <td><%= contact.nomor %></td>
      <td><a href="/contact/<%= contact.nama %>" class="btn btn-success badge rounded-pill"><i class="bi bi-info-circle"></i> detail</a></td>
    </tr>
    <% }) %>
    
  </tbody>
</table>
    </div>
    <div class="col-lg-5 decoration">
      <div class="layer">
        <img src="/img/ingredients.jpg" alt="ingredients">
      </div>
    </div>
  </div>
</div>